# Local secrets. Copy this file to .secrets and fill in real values.
# Never commit .secrets.

napcat:
  access_token: ""

qa:
  llm:
    api_key: ""

realname:
  # 实名白名单 QQ 号列表。白名单用户在招新群内视为已经实名，不会被入群禁言或续禁言。
  whitelist_users: []

  # 允许审核实名信息的 QQ 号列表。留空表示管理群内所有成员都能审核。
  admin_approvers: []

  #实名核验时登录智慧东大使用的账号
  username: ""
  password: ""
